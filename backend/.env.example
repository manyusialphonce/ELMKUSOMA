NODE_ENV=development
PORT=8000

FRONTEND_URL=http://localhost:5173

# --- Database (PostgreSQL via Prisma) ---
DATABASE_URL="postgresql://postgres:password@localhost:5432/elmkusoma?schema=public"

# --- JWT Auth ---
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# --- Redis (cache, sessions, queues - future) ---
REDIS_URL=redis://127.0.0.1:6379

# --- Object storage (recordings, notes, resources) ---
S3_ENDPOINT=https://fra1.digitaloceanspaces.com
S3_BUCKET=elmkusoma-content
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=fra1

# --- Live streaming provider ---
STREAMING_PROVIDER=agora
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# --- Payments (Tanzania) ---
PAYMENT_DEFAULT_PROVIDER=selcom
SELCOM_VENDOR_ID=
SELCOM_API_KEY=
SELCOM_API_SECRET=
CLICKPESA_API_KEY=
CLICKPESA_MERCHANT_ID=
